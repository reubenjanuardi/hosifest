# ---------------------------------------------------------------------------
# HOSIFEST local development environment — TEMPLATE ONLY
# Usage:
#   cp deploy/env.dev.example deploy/.env
#   docker compose --env-file deploy/.env -f deploy/docker-compose.dev.yml up
# The file is git-ignored; only the *.example template is committed.
# ---------------------------------------------------------------------------

NODE_ENV=development

APP_URL=http://localhost:8080
PUBLIC_API_URL=http://localhost:8080/api
STORAGE_ENDPOINT=
STORAGE_BUCKET=hosifest-local
PAYMENT_CONFIGURATION={"mode":"manual"}
LOG_LEVEL=debug

# Development-only credentials. These are throwaway local values.
JWT_SECRET=local-development-only-not-a-production-secret-0000
POSTGRES_DB=hosifest
POSTGRES_USER=hosifest
POSTGRES_PASSWORD=hosifest_local_dev_password
DATABASE_URL=postgres://hosifest:hosifest_local_dev_password@postgres:5432/hosifest

HOSIANA_NETWORK_NAME=hosiana_network
TZ=Asia/Jakarta