# ---------------------------------------------------------------------------
# HOSIFEST production environment — TEMPLATE ONLY
# Copy to deploy/.env (git-ignored) on the VPS and fill in real values.
# NEVER commit a filled-in copy of this file.
# ---------------------------------------------------------------------------

# --- Image coordinates (set by the deploy workflow) -------------------------
# IMAGE_TAG is immutable, e.g. sha-1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b
IMAGE_TAG=sha-REPLACE_WITH_COMMIT_SHA
# IMAGE_REGISTRY must resolve to the GHCR namespace holding the images,
# e.g. ghcr.io/your-org. Defaults to ghcr.io/<repo owner> when omitted.
IMAGE_REGISTRY=ghcr.io/REPLACE_WITH_GITHUB_ORG

# --- Application ------------------------------------------------------------
# NODE_ENV is fixed by compose for runtime; declared here for completeness.
NODE_ENV=production
# Canonical public origin, e.g. https://hosifest.example.id
APP_URL=https://REPLACE_WITH_PUBLIC_ORIGIN
# Browser-visible API base, reached through the frontend reverse proxy.
PUBLIC_API_URL=https://REPLACE_WITH_PUBLIC_ORIGIN/api
# 10.0.0.x internal Docker network or DNS name for object storage.
# Cloudflare R2 is S3-compatible: STORAGE_ENDPOINT is the jurisdiction-specific
# S3 endpoint, STORAGE_BUCKET the bucket name (NOT an https URL to a bucket path).
STORAGE_ENDPOINT=https://REPLACE_WITH_S3_COMPATIBLE_ENDPOINT
STORAGE_BUCKET=REPLACE_WITH_STORAGE_BUCKET
# local writes under STORAGE_LOCAL_ROOT; s3 uploads to the bucket above.
STORAGE_DRIVER=REPLACE_WITH_local_or_s3
# JSON blob describing QRIS / bank transfer accounts and manual-verify rules.
# Must never contain live banking secrets that are not already public to buyers.
PAYMENT_CONFIGURATION={"mode":"manual","methods":["qris","bank_transfer"]}
# debug | info | warn | error
LOG_LEVEL=info

# --- Secrets (supply via VPS secret store; keep out of git) ----------------
# Signed JWT secret, minimum 32 random bytes.
JWT_SECRET=REPLACE_WITH_64_HEX_CHARACTERS_RANDOM_SECRET
# S3-compatible object storage credentials (Cloudflare R2 API token).
# The Access Key ID / Secret Access Key pair below is the ONLY place live
# storage secrets live. Rotate the token in the Cloudflare dashboard, then
# update these two lines on the VPS — never paste secrets into chat.
STORAGE_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
STORAGE_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
# Least-privilege PostgreSQL role. Host is the service name `postgres`,
# because the backend resolves it over the private internal network.
DATABASE_URL=postgres://hosifest:REPLACE_WITH_DB_PASSWORD@postgres:5432/hosifest
POSTGRES_DB=hosifest
POSTGRES_USER=hosifest
POSTGRES_PASSWORD=REPLACE_WITH_DB_PASSWORD

# --- Infrastructure references ---------------------------------------------
# Existing external Docker network on the VPS. Created by the VPS operator,
# never by this project.
HOSIANA_NETWORK_NAME=hosiana_network
TZ=Asia/Jakarta

# --- Health gate (used by deploy/scripts/deploy.sh) --------------------------
# The /ready probe runs INSIDE the backend container over the internal compose
# network, so it needs no published port, no public hostname and no DNS. Only
# the path and port are configurable here.
BACKEND_PORT=3000
HEALTHCHECK_PATH=/ready