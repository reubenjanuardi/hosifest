{
  "name": "@hosifest/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.scripts.json && node -e \"const fs=require('fs');if(fs.existsSync('dist-scripts')){fs.cpSync('dist-scripts','dist',{recursive:true});fs.rmSync('dist-scripts',{recursive:true,force:true});}\"",
    "start": "node dist/server.js",
    "migrate": "node dist/scripts/migrate.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node dist/scripts/seed.js",
    "build:migrate": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.2.2",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "pnpm": {
      "onlyBuiltDependencies": [
        "esbuild"
      ],
      "overrides": {
        "brace-expansion": "^5.0.10",
        "ip-address": "^10.3.1",
        "pacote": "^21.5.1",
        "picomatch": "^4.0.4",
        "sigstore": "^4.1.1"
      }
    }
}
