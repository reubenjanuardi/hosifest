# Backend runtime configuration.
# NEVER commit real secrets. Copy to .env and inject values from the secret store.

NODE_ENV=development
HOST=0.0.0.0
PORT=3001
APP_URL=http://localhost:3001

# Required. PostgreSQL is private; it must never be exposed publicly.
DATABASE_URL=postgresql://hosifest:CHANGE_ME@postgres:5432/hosifest

# Required. Minimum 16 characters. Provide via secret store in production.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
JWT_EXPIRES_IN=12h

LOG_LEVEL=info

# Payment proof storage (local driver for MVP; S3 driver left to the deploy layer).
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./var/storage
STORAGE_BASE_URL=/uploads
STORAGE_MAX_UPLOAD_BYTES=10485760
STORAGE_ALLOWED_MIME=image/jpeg,image/png,image/webp,application/pdf

# Rate limiting (public-sensitive endpoints tighten these per route).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_ORDER_MAX=20
RATE_LIMIT_PROOF_MAX=10
RATE_LIMIT_TICKET_MAX=60
RATE_LIMIT_ATTENDANCE_MAX=120
