# Only PUBLIC values belong in NEXT_PUBLIC_* — it is inlined into browser JS.
#
# This is the browser-visible API origin as reached through this frontend. When the
# frontend nginx reverse-proxies /api/* to the backend (the production topology),
# leave this EMPTY so the browser calls same-origin /api/v1 and never needs to know
# the backend address. Set it only for split-host deployments.
NEXT_PUBLIC_API_URL=

# Server-side only (never exposed to the browser). Used by React Server Components
# during SSR/build. In the container the backend is reachable over the internal
# Docker network; DevOps passes BACKEND_UPSTREAM to nginx, which proxies /api, so
# this may also be left empty in production.
API_INTERNAL_URL=

# NOTE: NEXT_PUBLIC_API_URL is a BUILD argument in the Dockerfile, not a runtime
# environment variable, because Next.js inlines it at build time. Set it in the
# image build step, not only in the container environment.
